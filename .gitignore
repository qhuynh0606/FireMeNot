# --- Data & models (never commit) ---
data/*
!data/.gitkeep
/models/
*.npy
*.npz
*.pkl
*.joblib
*.pt
*.pth
*.h5
*.ckpt

# results/metrics.csv IS committed so the team shares one results table
results/*
!results/.gitkeep
!results/metrics.csv

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/

# --- Notebooks / editors / OS ---
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
